#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

case "${1:-all}" in
  all)
    node --test
    python3 -m unittest discover -s tests -p 'test_space_app.py'
    node --check web/games.js
    node --check web/csv.js
    node --check web/app.js
    python3 -m py_compile app.py
    bash -n scripts/release.sh
    ;;
  test)
    node --test
    ;;
  syntax)
    node --check web/games.js
    node --check web/csv.js
    node --check web/app.js
    python3 -m py_compile app.py
    bash -n scripts/release.sh
    ;;
  *)
    echo "usage: scripts/check [all|test|syntax]" >&2
    exit 2
    ;;
esac
